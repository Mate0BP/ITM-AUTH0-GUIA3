# Puerto del servidor local
PORT=3000

# ========================================================
# CONFIGURACIÓN AUTH0: APLICACIÓN WEB (Para el Login)
# Obtenida en Auth0 Dashboard > Applications > Applications > [Tu App Regular Web]
# ========================================================
# Secreto aleatorio largo (mínimo 32 caracteres) para encriptar la cookie de sesión
AUTH0_SECRET=7f9b8c6e5d4a3b2c1d0e9f8a7b6c5d4e3f2a1b0c9d8e7f6a5b4c3d2e1f0a9b8c

# URL base de tu aplicación local
AUTH0_BASE_URL=http://localhost:3000

# Client ID de tu Regular Web Application
AUTH0_CLIENT_ID=tu_client_id_aqui

# Client Secret de tu Regular Web Application
AUTH0_CLIENT_SECRET=tu_client_secret_aqui

# Dominio de tu tenant (ejemplo: dev-xyz123.us.auth0.com)
AUTH0_ISSUER_BASE_URL=https://tu-tenant.us.auth0.com

# ========================================================
# CONFIGURACIÓN AUTH0: MANAGEMENT API (Para user_metadata)
# Obtenida en Auth0 Dashboard > Applications > Applications > [Tu App M2M] o Auth0 Management API (Test Application)
# Permisos requeridos en la API: read:users, update:users
# ========================================================
AUTH0_M2M_CLIENT_ID=tu_m2m_client_id_aqui
AUTH0_M2M_CLIENT_SECRET=tu_m2m_client_secret_aqui
